<Window x:Class="Motwane_UVSS.AicViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIC Viewer" Height="800" Width="1000"
        AllowsTransparency="True" WindowState="Maximized" WindowStyle="None" Background="Transparent">

    <!-- Define styles for our modern buttons -->
    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Border for rounded corners and a subtle shadow effect -->
    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="#F5F5F5">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#AAAAAA" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row for Title Bar -->
                <RowDefinition Height="*"/>
                <!-- Row for Content -->
                <RowDefinition Height="Auto"/>
                <!-- Row for Exit Button -->
            </Grid.RowDefinitions>

            <!-- Title Bar Area with a slightly darker background -->
            <Border Grid.Row="0" Height="40" Background="#EAEAEA" CornerRadius="8,8,0,0" MouseDown="Border_MouseDown">
                <Grid>
                    <TextBlock Text="AIC Viewer" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Blue"/>
                    <Button x:Name="btnClose" Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" 
                            FontWeight="Bold" FontSize="14" Foreground="#555" Background="Transparent" BorderThickness="0" Click="btnClose_Click"/>
                </Grid>
            </Border>

            <!-- Responsive Grid for Images -->
            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Current Image : " FontWeight="Bold" Foreground="Blue"/>
                <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,5,0,10" CornerRadius="5">
                    <Image x:Name="imageAicResult" Stretch="Fill" />
                </Border>

                <Label x:Name="labelRefInfo" Grid.Row="2" Content="Ref. Img: (Previous Vehicle from Database)" FontWeight="Bold" Foreground="Blue"/>
                <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,5,0,0" CornerRadius="5">
                    <Image x:Name="imageRef" Stretch="Fill" />
                </Border>
            </Grid>

            <!-- NEW: Exit Button Area -->
            <Grid Grid.Row="2" Margin="0,10,0,15">
                <Button x:Name="btnExit" Content="Exit" Width="120" Height="40" 
                        HorizontalAlignment="Center" 
                        Style="{StaticResource ModernButtonStyle}" 
                        Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

