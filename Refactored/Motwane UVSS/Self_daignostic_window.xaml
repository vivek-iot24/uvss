<Window x:Class="Motwane_UVSS.Self_daignostic_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Motwane_UVSS"
        mc:Ignorable="d"
        Title="Motwane Under Vehical Scanning System-AreaScan" Height="1100" Width="1920" WindowState="Maximized" Icon="D:\Work_uvss\logo-motwane-90x90.ico">

    <Grid>
        <Image Source="D:\Work_uvss\MUVSS.png" Stretch="Fill"/>

        <Border CornerRadius="20" 
                Background="White" 
                Padding="30"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MaxWidth="1400"
                MaxHeight="850">

            <StackPanel Orientation="Vertical">
                <TextBlock Foreground="#007ACC" Text="Self Diagnostic" FontSize="60" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <StackPanel x:Name="self_daigno_information_stack" Orientation="Vertical" HorizontalAlignment="Left" Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="Area Scanning Camera : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="area_scan_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="ANPR Camera : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="ANPR_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="Driver Camera : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="Driver_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="Video Camera 1 : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="Video_1_scan_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="Video Camera 2 : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="Video_2_scan_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="Video Camera 3 : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="Video_3_scan_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock FontSize="40" Text="Com 3 : " TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                        <TextBlock x:Name="com_scan_StatusTextBlock" FontSize="40" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#007ACC"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <ProgressBar x:Name="LoaderBar" Width="200" Height="20" IsIndeterminate="True" Visibility="Collapsed"/>
                    <TextBlock x:Name="LoadingText" Text="Checking..." Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" FontSize="16" Foreground="#007ACC"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,50,0,0" HorizontalAlignment="Right">
                    <Border Margin="10" BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" Background="#007ACC">
                        <Button Content="Print" x:Name="Print_btn" Click="Print_btn_Click" FontSize="35" Foreground="White" Background="Transparent" Margin="5" BorderThickness="0" FontWeight="SemiBold"/>
                    </Border>
                    <Border Margin="10" BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" Background="#007ACC">
                        <Button Content="Exit" x:Name="Exit_button" Click="Exit_button_Click" FontSize="35" Foreground="White" Background="Transparent" Margin="5" BorderThickness="0" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>