<Window x:Class="Motwane.UVSS.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login Screen"
        Width="1920"
        Height="1080"
        Topmost="True"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
          Closed="Window_Closed">

    <Window.Resources>
        <!-- Color definitions -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#007AB6"/>
        <SolidColorBrush x:Key="LinkBlue" Color="#389DD2"/>
        <SolidColorBrush x:Key="ActiveTextBlue" Color="#0864A3"/>
        <SolidColorBrush x:Key="PlaceholderGray" Color="#737373"/>
        <SolidColorBrush x:Key="BorderGray" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#22D9D9D9"/>

        <!-- Input field style -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                               >
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password field style -->
        <Style x:Key="PasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                >
                            <ScrollViewer
    x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="DropdownStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                 >
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="16,0,40,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="PlaceholderText"
                                               Text="Type"
                                               Foreground="#737373"
                                               FontFamily="Montserrat"
                                               FontSize="14"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Focusable="False"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Right"
                                                  Width="40"
                                                  Margin="0,0,4,0">
                                        <Path Data="M0,0 L8,8 L16,0"
                                              Stroke="#D9D9D9"
                                              StrokeThickness="2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <Popup x:Name="Popup"
                                           Placement="Bottom"
                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Slide">
                                        <Grid x:Name="DropDown"
                                              SnapsToDevicePixels="True"
                                              MinWidth="{TemplateBinding ActualWidth}"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder"
                                                    Background="White"
                                                    BorderBrush="#E5E5E5"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox item style -->
        <Style x:Key="DropdownItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#F0F8FF"/>
                                <Setter Property="Foreground" Value="#0864A3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#0864A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Submit button style -->
        <Style x:Key="SubmitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007AB6"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,8">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="4" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005F8E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop shadow for input fields -->
        <DropShadowEffect x:Key="InputShadow"
                          Color="Black"
                          Opacity="0.05"
                          BlurRadius="4"
                          ShadowDepth="1"
                          Direction="270"/>
    </Window.Resources>

    <!-- Root canvas for absolute positioning matching the 1920x1080 Figma layout -->
    <Viewbox Stretch="Uniform"  >
        <Canvas Width="1920" Height="1080" ClipToBounds="True" Background="#DEDDE1">

            <!-- ═══════════════════════════════════════════════════
                 BACKGROUND IMAGE (FinalFinal 1 — full screen)
                 Replace the Source path with your actual image.
                 ═══════════════════════════════════════════════════ -->
            <Image Canvas.Left="0" Canvas.Top="0"
                   Width="1920" Height="1080"
                   Source="D:\motwane-refactored-uvss\Refactored\Motwane UVSS\Assets\Login Screen Light-Z1A.jpg"
                   Stretch="UniformToFill"/>

            <!-- ═══════════════════════════════════════════════
                 CAMERA LABELS (left side of screen)
                 ═══════════════════════════════════════════════ -->

            <!-- DRIVER CAMERA label -->

            <!-- Driver camera status -->
            <StackPanel Canvas.Left="1218" Canvas.Top="313" Height="24"/>

            <!-- ANPR CAMERA label -->

            <!-- ANPR camera status -->
            <StackPanel Canvas.Left="1218" Canvas.Top="592" Height="24"/>

            <!-- ═══════════════════════════════════════════════
                 LOGIN PANEL — semi-transparent frosted card
                 ═══════════════════════════════════════════════ -->
            <Border Canvas.Left="1354" Canvas.Top="205"
                    Width="569" Height="670"
                    CornerRadius="32"
                    Background="#33D9D9D9" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- ═══════════════════════════════════════════════
                 LOGO IMAGES (inside panel header)
                 Replace Source paths with your actual logo files.
                 ═══════════════════════════════════════════════ 
            <Image Canvas.Left="1443" Canvas.Top="319"
                   Width="385" Height="77"
                   Source="Assets/image12.png"
                   Stretch="UniformToFill"/>
            <Image Canvas.Left="1442" Canvas.Top="317"
                   Width="385" Height="77"
                   Source="Assets/image13.png"
                   Stretch="UniformToFill"/>-->

            <!-- ═══════════════════════════════════════════════
                 LOG IN HEADING
                 ═══════════════════════════════════════════════ -->
            <TextBlock Canvas.Left="1599" Canvas.Top="461"
                       Text="Log In"
                       FontFamily="Montserrat"
                       FontSize="24"
                       Foreground="White"
                       LineHeight="34.8" HorizontalAlignment="Left" Background="#DEDDE1" VerticalAlignment="Center" Width="86"/>

            <!-- ═══════════════════════════════════════════════
                 USERNAME FIELD
                 ═══════════════════════════════════════════════ -->
            <Border
    Canvas.Left="1446"
    Canvas.Top="508"
    Width="379"
    Height="40"
    Background="White"
    CornerRadius="8"
    BorderBrush="#E5E5E5"
    BorderThickness="1">

                <Grid>
                    <TextBox
        x:Name="UsernameField"
        Style="{StaticResource InputFieldStyle}"
        TextChanged="UsernameField_TextChanged"/>

                    <TextBlock
        x:Name="UsernamePlaceholder"
        Margin="16,0,0,0"
        VerticalAlignment="Center"
        Text="User Name"
        Foreground="#737373"
        IsHitTestVisible="False"/>
                </Grid>

            </Border>

            <!-- ═══════════════════════════════════════════════
                 PASSWORD FIELD
                 ═══════════════════════════════════════════════ -->
            <Border Canvas.Left="1446" Canvas.Top="564"
                    Width="379" Height="40"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="2" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <PasswordBox
    x:Name="PasswordField"
    PasswordChanged="PasswordField_PasswordChanged"
    Margin="16,0,0,0"
    BorderThickness="0"
    Background="Transparent"
    VerticalContentAlignment="Center"/>
                    <!-- Placeholder text (hidden once user types — handle in code-behind) -->
                    <TextBlock x:Name="PasswordPlaceholder"
                               Text="Password"
                               Foreground="#737373"
                               FontFamily="Montserrat"
                               FontSize="14"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <!-- Eye / toggle icon -->
                    <Button x:Name="TogglePasswordBtn"
                            Width="20" Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Show / Hide password">
                        <Path Data="M12,9 A3,3,0,1,1,12,15 A3,3,0,1,1,12,9 M2,12 Q7,4,12,4 Q17,4,22,12 Q17,20,12,20 Q7,20,2,12 Z"
                              Stroke="#737373"
                              StrokeThickness="1.2"
                              Fill="Transparent"
                              Width="16" Height="16"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════
                 TYPE DROPDOWN  (Admin / Operator / Service)
                 ═══════════════════════════════════════════════ -->
            <Border Canvas.Left="1446" Canvas.Top="621"
                    Width="379" Height="40"
                    CornerRadius="8"
                    Background="White"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="2" ShadowDepth="1" Direction="270"/>
                </Border.Effect>
                <ComboBox x:Name="TypeDropdown"
                          Style="{StaticResource DropdownStyle}"
                          ItemContainerStyle="{StaticResource DropdownItemStyle}"
                          BorderThickness="0"
                          Background="Transparent">
                    <ComboBoxItem Content="Admin"   Style="{StaticResource DropdownItemStyle}"/>
                    <ComboBoxItem Content="Operator" Style="{StaticResource DropdownItemStyle}"/>
                    <ComboBoxItem Content="Service"  Style="{StaticResource DropdownItemStyle}"/>
                </ComboBox>
            </Border>

            <!-- ═══════════════════════════════════════════════
                 FORGOT PASSWORD LINK
                 ═══════════════════════════════════════════════ -->
            <TextBlock Canvas.Left="1733" Canvas.Top="669"
                       Text="Forgot Password?"
                       FontFamily="Montserrat"
                       FontSize="10"
                       Foreground="#389DD2"
                       LineHeight="20"
                       Cursor="Hand" HorizontalAlignment="Left"  Background="#DEDDE1" VerticalAlignment="Top" Width="95" Height="22">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding ForgotPasswordCommand}"/>
                </TextBlock.InputBindings>
            </TextBlock>

            <!-- ═══════════════════════════════════════════════
                 SUBMIT BUTTON
                 ═══════════════════════════════════════════════ -->
            <Button Canvas.Left="1580" Canvas.Top="677"
                    Width="111" Height="36"
                    Style="{StaticResource SubmitButtonStyle}"
                    Content="Submit"
                    Click="Button_Click"/>

        </Canvas>
    </Viewbox>
</Window>
