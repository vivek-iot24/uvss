<Window x:Class="Motwane.UVSS.Presentation.Windows.About_screen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Motwane.UVSS.Presentation.Windows"
        mc:Ignorable="d"
        Title="Motwane Under Vehical Scanning System-AreaScan"
        Height="1100"
        Width="1920"
        WindowState="Maximized"
        Icon="/Resources/logo-motwane-90x90.ico">
    <Grid>
        <Image Source="/Resources/MUVSS.png" Stretch="Fill"/>

        <Border CornerRadius="20" 
                Background="White" 
                Padding="30"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MaxWidth="1000"
                BorderBrush="#007ACC"
                BorderThickness="5">

            <StackPanel Orientation="Vertical">
                <TextBlock Foreground="#007ACC" Text="About" FontSize="60" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <TextBlock Margin="0,10" Text="Product Name: MOTWANE'S Under Vehical Scanning System" Foreground="#007ACC" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Margin="0,10" Text="Product Model No: MUVSS-SMV" Foreground="#007ACC" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Margin="0,10" Text="Product Seriel No: UVSS/08/25/001" Foreground="#007ACC" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Margin="0,10" Text="Software Version: Ver 1.0.1" Foreground="#007ACC" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Margin="0,10" Text="Manufacturing Month/Year: 08/2025" Foreground="#007ACC" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Margin="0,10" Text="Warranty Valid upto: 08/2026" Foreground="#007ACC" FontSize="30" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border Margin="0,0,100,100" 
                    BorderBrush="#007ACC" 
                    BorderThickness="3" 
                    CornerRadius="10"
                    Width="200"
                    Background="#007ACC">
                <Button Content="Exit" FontSize="35" x:Name="exit_btn" Click="exit_btn_Click" Foreground="White" Background="Transparent" Margin="5,5,5,5" BorderThickness="0" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</Window>