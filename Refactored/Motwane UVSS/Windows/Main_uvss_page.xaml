<Window x:Class="Motwane.UVSS.Presentation.Windows.Main_uvss_page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Motwane.UVSS.Presentation.Windows"
        mc:Ignorable="d"
        Title="Motwane Under Vehical Scanning System-AreaScan"
        Closing="Window_Closing"
        Height="1100"
        Width="1920"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        Icon="/Resources/logo-motwane-90x90.ico">

    <Grid x:Name="mother_grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <!-- Bottom Panel of Controls -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="MidnightBlue"
                BorderThickness="2"
                CornerRadius="10"
                Margin="5,5,5,5"
                Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SECTION -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sensor Status"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#007ACC" />
                        <Ellipse x:Name="sensor_display"
                                 Fill="Green"
                                 Width="16"
                                 Height="16"
                                 Margin="8,4,0,0" />
                        <TextBlock x:Name="sensor_feed"
                                   Width="40" />
                    </StackPanel>


                    <StackPanel Orientation="Vertical"
            Margin="0,2,0,0"
            VerticalAlignment="Center">

                        <!-- Canvas -->
                        <Canvas Width="60"
            Height="60"
            HorizontalAlignment="Left">
                            <!-- Head -->
                            <Ellipse Width="22"
                 Height="22"
                 Fill="Gray"
                 Canvas.Left="19"
                 Canvas.Top="0" />
                            <!-- Body -->
                            <Path Fill="Gray"
              Canvas.Left="5"
              Canvas.Top="25"
              Data="M 25,0 C 0,0 0,25 0,25 H 50 C 50,25 50,0 25,0 Z" />
                        </Canvas>

                        <!-- Username (aligned like before, not centered) -->
                        <TextBlock x:Name="username_textbox"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#007ACC"
               TextWrapping="NoWrap"
               Width="165"
               Margin="8,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- CENTER BUTTONS -->
                <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="-260,0,0,0">
                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="PREVIOUS"
                                x:Name="driver_previous_image"
                                Click="driver_previous_image_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>

                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="RESET"
                                x:Name="reset_button"
                                Click="reset_button_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>
                    <Popup x:Name="HoldPopup"
       PlacementTarget="{Binding ElementName=HOLD_BTN}"
       Placement="Top"
       StaysOpen="False"
       AllowsTransparency="True"
       PopupAnimation="Fade">

                        <Border Background="#FAFAFA"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="12"
            Padding="15">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15"
                              ShadowDepth="2"
                              Opacity="0.25"
                              Color="Black"/>
                            </Border.Effect>

                            <StackPanel>

                                <!-- Title -->
                                <TextBlock Text="Select Category"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Foreground="#444"
                       Margin="5"
                       HorizontalAlignment="Center"/>

                                <!-- ALL OPTIONS -->
                                <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,5">

                                    <ToggleButton Content="Wanted" Width="100" Margin="5"
                              Background="#F5F5F5" BorderBrush="#DDD"
                              Padding="8" Click="HoldOption_Click"/>

                                    <ToggleButton Content="Suspicious" Width="100" Margin="5"
                              Background="#F5F5F5" BorderBrush="#DDD"
                              Padding="8" Click="HoldOption_Click"/>

                                    <ToggleButton Content="Stolen" Width="100" Margin="5"
                              Background="#F5F5F5" BorderBrush="#DDD"
                              Padding="8" Click="HoldOption_Click"/>

                                    <ToggleButton Content="Expired" Width="100" Margin="5"
                              Background="#F5F5F5" BorderBrush="#DDD"
                              Padding="8" Click="HoldOption_Click"/>

                                    <ToggleButton Content="Other" Width="100" Margin="5"
                              Background="#F5F5F5" BorderBrush="#DDD"
                              Padding="8" Click="HoldOption_Click"/>

                                    <ToggleButton Content="Normal" Width="100" Margin="5"
                              Background="#F5F5F5" BorderBrush="#DDD"
                              Padding="8" Click="HoldOption_Click"/>

                                </WrapPanel>

                                <!-- Apply -->
                                <Button Content="Apply"
                    Margin="10,10,10,0"
                    Background="#007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="8"
                    Width="110"
                    HorizontalAlignment="Center"
                    Click="ApplyHold_Click"/>

                            </StackPanel>
                        </Border>
                    </Popup>

                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="HOLD"
                                x:Name="HOLD_BTN"
                                Click="HOLD_BTN_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>

                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="PASS"
                                x:Name="PASS_BTN"
                                Click="PASS_BTN_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>

                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="AIC"
                                x:Name="AIC_btn"
                                Click="AIC_btn_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>

                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="Load Image"
                                x:Name="btnLoadImage"
                                Click="btnLoadImage_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>

                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="10">
                        <Button Content="NEXT"
                                x:Name="driver_next_image"
                                Click="driver_next_image_Click"
                                FontSize="16"
                                Foreground="#007ACC"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="20,5"/>
                    </Border>
                </StackPanel>



                <!-- RIGHT SECTION -->
                <StackPanel Grid.Column="2"
                            Orientation="Vertical"
                            VerticalAlignment="Top"
                            Margin="20,0">
                    <!-- MENU BUTTON (Three lines icon) -->
                    <Border BorderBrush="#007ACC" 
                            BorderThickness="3" 
                            CornerRadius="10" 
                            Margin="0,0,0,10"
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Right">
                        <Button x:Name="menu_button"
                                Click="menu_button_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <TextBlock Text="☰" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Border>

                    <!-- TIME -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock x:Name="DateTextBlock"
                                   FontSize="12"
                                   Foreground="#007ACC"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="TimeTextBlock"
                                   FontSize="12"
                                   Foreground="#007ACC"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top section with the main image and side panel -->
        <Grid Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- MAIN IMAGE SECTION -->
            <Border Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="MidnightBlue"
                    BorderThickness="2"
                    CornerRadius="10"
                    Margin="5,5,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="12*" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid x:Name="grid_for_sticth" ClipToBounds="True">
                        <Image Panel.ZIndex="1"
                               Name="Sticked_image"
                               Source="/Resources/MUVSS.png"
                               ImageFailed="Sticked_image_ImageFailed"
                               MouseLeftButtonDown="Sticked_image_MouseLeftButtonDown"
                               Stretch="Fill"
                               MouseWheel="Sticked_image_MouseWheel">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="imageScaleTransform" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="imageTranslateTransform" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

                    <!-- SLIDERS -->
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal"
                                    Margin="10"
                                    HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                                <TextBlock Text="Brightness"
                                           HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#007ACC" />
                                <Slider x:Name="BrightnessSlider"
                                        ValueChanged="BrightnessSlider_ValueChanged"
                                        Minimum="0.1"
                                        Maximum="3.0"
                                        Value="1.0"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Width="100"
                                        Height="30"
                                        Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <TextBlock Text="Contrast"
                                           HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#007ACC" />
                                <Slider x:Name="ContrastSlider"
                                        ValueChanged="ContrastSlider_ValueChanged"
                                        Minimum="0"
                                        Maximum="2"
                                        Value="1"
                                        Width="100"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Height="30"
                                        Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <TextBlock Text="Sharpness"
                                           HorizontalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#007ACC" />
                                <Slider x:Name="SharpnessSlider"
                                        ValueChanged="SharpnessSlider_ValueChanged"
                                        Minimum="0"
                                        Maximum="5.0"
                                        Value="0"
                                        Width="100"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        Height="30"
                                        Margin="10,0,0,0" />
                            </StackPanel>

                            <!-- Debug buttons (Collapsed) -->
                            <Button Content="try" 
                                    Margin="50,0,0,0" 
                                    x:Name="try_btn" 
                                    Click="try_btn_Click" 
                                    Visibility="Collapsed" />
                            <Button Content="try" 
                                    Margin="50,0,0,0" 
                                    x:Name="try1_btn" 
                                    Click="try1_btn_Click" 
                                    Visibility="Collapsed" />
                            <Button Content="try" 
                                    Margin="50,0,0,0" 
                                    x:Name="try2_btn" 
                                    Click="try2_btn_Click" 
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- SIDE PANEL - FIXED -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5*" />
                    <!-- ANPR IMAGE - SAME SIZE -->
                    <RowDefinition Height="2.5*" />
                    <!-- DRIVER IMAGE - SAME SIZE -->
                    <RowDefinition Height="1.5*" />
                    <!-- 2x2 GRID - INCREASED SIZE -->
                    <RowDefinition Height="Auto" />
                    <!-- Spacer -->
                </Grid.RowDefinitions>

                <!-- ANPR IMAGE -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        BorderBrush="MidnightBlue"
                        BorderThickness="2"
                        CornerRadius="10"
                        Margin="0,5,5,2">
                    <Grid>
                        <Image x:Name="Anpr_image"
                               Source="/Resources/MUVSS.png"
                               Stretch="Uniform" />
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="5"
                                CornerRadius="3"
                                Background="Transparent"
                                BorderThickness="3"
                                BorderBrush="MidnightBlue">
                            <TextBlock Text="ANPR Image"
                                       FontSize="12"
                                       Foreground="#007ACC"
                                       FontWeight="SemiBold"
                                       Margin="5,2" />
                        </Border>
                    </Grid>
                </Border>

                <!-- DRIVER IMAGE - SAME SIZE AS ANPR -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="MidnightBlue"
                        BorderThickness="2"
                        CornerRadius="10"
                        Margin="0,2,5,2">
                    <Grid>
                        <Image x:Name="Driver_image"
                               Source="/Resources/MUVSS.png"
                               Stretch="Uniform" />
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Margin="5"
                                CornerRadius="3"
                                Background="Transparent"
                                BorderThickness="3"
                                BorderBrush="MidnightBlue">
                            <TextBlock Text="Driver Image"
                                       FontSize="12"
                                       Foreground="#007ACC"
                                       FontWeight="SemiBold"
                                       Margin="5,2"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- COMBINED 2x2 GRID FOR NUMBER PLATE & LOGO - Grid.Row="2" -->
                <Border Grid.Row="2"
        Background="Transparent"
        BorderBrush="MidnightBlue"
        BorderThickness="2"
        CornerRadius="10"
        Margin="0,2,5,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NUMBER PLATE IMAGE (Top-Left) -->
                        <Border Grid.Row="0" Grid.Column="0"
                Background="Transparent"
                BorderBrush="MidnightBlue"
                BorderThickness="1"
                CornerRadius="5"
                Margin="2">
                            <Grid>
                                <Image x:Name="numberplate_image" Stretch="Fill" />
                                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="3"
                        CornerRadius="3"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="MidnightBlue">
                                    <TextBlock Text="Number Plate Image"
                               FontSize="10"
                               Foreground="#007ACC"
                               FontWeight="SemiBold"
                               Margin="3,1" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- LOGO IMAGE (Top-Right) -->
                        <Border Grid.Row="0" Grid.Column="1"
                Background="Transparent"
                BorderBrush="MidnightBlue"
                BorderThickness="1"
                CornerRadius="5"
                Margin="2">
                            <Grid>
                                <Image x:Name="LogoImage"
                       Stretch="Uniform"
                       Margin="5" />
                                <Border VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="3"
                        CornerRadius="3"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="MidnightBlue">
                                    <TextBlock Text="Logo Image"
                               FontSize="10"
                               Foreground="#007ACC"
                               FontWeight="SemiBold"
                               Margin="3,1"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- NUMBER PLATE TEXT (Bottom-Left) -->
                        <Border Grid.Row="1" Grid.Column="0"
                Background="Transparent"
                BorderBrush="MidnightBlue"
                BorderThickness="1"
                CornerRadius="5"
                Margin="2">
                            <Grid>
                                <TextBox x:Name="Numberplate_number_box"
                                         
                         Margin="3"
                         BorderThickness="0"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontSize="20" />
                                <Border VerticalAlignment="Top" 
                        HorizontalAlignment="Left" 
                        Margin="3"
                        CornerRadius="3"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="MidnightBlue"
                        IsHitTestVisible="False">
                                    <TextBlock Text="Number Plate"
                               FontSize="10"
                               Foreground="#007ACC"
                               FontWeight="SemiBold"
                               Margin="3,1"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- LOGO TEXT (Bottom-Right) -->
                        <Border Grid.Row="1" Grid.Column="1"
                Background="Transparent"
                BorderBrush="MidnightBlue"
                BorderThickness="1"
                CornerRadius="5"
                Margin="2">
                            <Grid>
                                <TextBox x:Name="logo_textbox"
                         Margin="3"
                         BorderThickness="0"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontSize="18" />
                                <Border VerticalAlignment="Top" 
                        HorizontalAlignment="Left" 
                        Margin="3"
                        CornerRadius="3"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="MidnightBlue"
                        IsHitTestVisible="False">
                                    <TextBlock Text="Logo Text"
                               FontSize="10"
                               Foreground="#007ACC"
                               FontWeight="SemiBold"
                               Margin="3,1"/>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window> 