<Window x:Class="Motwane_UVSS.Presentation.Windows.Main_uvss_page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Motwane_UVSS"
        mc:Ignorable="d"
        Title="Motwane Under Vehical Scanning System-AreaScan" Closing="Window_Closing" Height="1100" Width="1920" WindowState="Maximized" Loaded="Window_Loaded" Closed="Window_Closed" Icon="D:\Work_uvss\logo-motwane-90x90.ico">

    <Grid x:Name="mother_grid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="590*"/>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Bottom Panel of Controls -->
        <Border Grid.Row="1" Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="5,5,5,5" Grid.ColumnSpan="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="Sensor Status" FontSize="30" FontWeight="SemiBold" Foreground="#007ACC"/>
                            <Ellipse x:Name="sensor_display" Fill="Green" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5,0,0"/>
                            <TextBlock x:Name="sensor_feed" Width="50"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,50,0,0">
                            <Canvas >
                                <Ellipse Width="40" Height="40" Fill="Gray" Canvas.Left="30" Canvas.Top="10"/>
                                <Path Fill="Gray" Canvas.Left="20" Canvas.Top="50"
                                Data="M 30,0 C 0,0 0,40 0,40 H 60 C 60,40 60,0 30,0 Z"/>
                            </Canvas>
                            <StackPanel Orientation="Vertical" Margin="100,10,0,0" >
                                <TextBlock x:Name="username_textbox" FontSize="30" FontWeight="SemiBold" Foreground="#007ACC"/>
                                <TextBlock x:Name="usertype_textbox" FontSize="30" FontWeight="SemiBold" Foreground="#007ACC"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" HorizontalAlignment="Left" >
                            <Button Content="HOLD" x:Name="HOLD_BTN" Click="HOLD_BTN_Click" FontSize="35" Foreground="#007ACC" Background="Transparent" Margin="5,5,5,5" BorderThickness="0"/>
                        </Border>
                        <Border Margin="50,0,50,0" BorderBrush="#007ACC"  BorderThickness="3" CornerRadius="10" HorizontalAlignment="Center">
                            <Button Content="PASS" x:Name="PASS_BTN" Click="PASS_BTN_Click" FontSize="35" Foreground="#007ACC" Background="Transparent" Margin="5,5,5,5" BorderThickness="0"/>
                        </Border>
                        <Border Margin="0,0,50,0" BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" HorizontalAlignment="Center">
                            <Button Content="RESET" x:Name="reset_button" Click="reset_button_Click" FontSize="35" Foreground="#007ACC" Background="Transparent" Margin="5,5,5,5" BorderThickness="0"/>
                        </Border>
                        <Border BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" HorizontalAlignment="Right">
                            <Button Content="MENU" x:Name="menu_button" Click="menu_button_Click" FontSize="35" Foreground="#007ACC" Background="Transparent" Margin="5,5,5,5" BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid VerticalAlignment="Top" Margin="2,2,2,2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="Category:" FontSize="25" FontWeight="SemiBold" Foreground="#007ACC"/>
                            <ComboBox x:Name="remark_txtbox" Width="350" Margin="5,5,0,0" BorderThickness="2" BorderBrush="#007ACC" FontSize="20" SelectedIndex="5">
                                <ComboBoxItem Content="Wanted"/>
                                <ComboBoxItem Content="Suspicious"/>
                                <ComboBoxItem Content="Stolen"/>
                                <ComboBoxItem Content="Expired"/>
                                <ComboBoxItem Content="Other"/>
                                <ComboBoxItem Content="Normal"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"  Background="Transparent" Margin="0,0,10,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="DateTextBlock" FontSize="15" Foreground="#007ACC" Height="25" TextAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TimeTextBlock" FontSize="15" Foreground="#007ACC" Height="25" TextAlignment="Center" Margin="0,-5,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Top section with the main image and side panel -->
        <Grid Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="5,5,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="12*"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="grid_for_sticth" ClipToBounds="True">
                        <Image Panel.ZIndex="1" Name="Sticked_image" Source="D:\Work_uvss\MUVSS.png"  ImageFailed="Sticked_image_ImageFailed" MouseLeftButtonDown="Sticked_image_MouseLeftButtonDown"  Stretch="Fill" MouseWheel="Sticked_image_MouseWheel">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="imageScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="imageTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                            <Button Content="Load Image" x:Name="btnLoadImage" Click="btnLoadImage_Click" Width="125" Margin="0,0,50,0" FontSize="20" FontWeight="SemiBold" Foreground="White" Background="#007ACC"/>
                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal" >
                                <TextBlock Text="Brightness" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#007ACC"/>
                                <Slider x:Name="BrightnessSlider" ValueChanged="BrightnessSlider_ValueChanged" Minimum="0.1" Maximum="3.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="100" Height="30" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <TextBlock Text="Contrast" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#007ACC"/>
                                <Slider x:Name="ContrastSlider" ValueChanged="ContrastSlider_ValueChanged" Minimum="0" Maximum="2" Value="1" Width="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Height="30" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <TextBlock Text="Sharpness" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#007ACC"/>
                                <Slider  x:Name="SharpnessSlider" ValueChanged="SharpnessSlider_ValueChanged" Minimum="0" Maximum="5.0" Value="0" Width="100" TickFrequency="0.5" IsSnapToTickEnabled="True" Height="30" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                                <TextBlock Text="Zoom" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#007ACC"/>
                                <Slider x:Name="ZoomSlider" Minimum="0" Maximum="30" Value="1" Width="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Height="30" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button Content="try" Margin="50,0,0,0" x:Name="try_btn" Click="try_btn_Click" Visibility="Collapsed"/>
                            <Button Content="try" Margin="50,0,0,0" x:Name="try1_btn" Click="try1_btn_Click" Visibility="Collapsed"/>
                            <Button Content="try" Margin="50,0,0,0" x:Name="try2_btn" Click="try2_btn_Click" Visibility="Collapsed"/>
                            <Button Content="AIC" Margin="50,0,0,0" Width="100" x:Name="AIC_btn" Click="AIC_btn_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Side panel with the ANPR, Number Plate, and Driver images -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>

                <!-- ANPR Image Section -->
                <Border Grid.Row="0" Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="0,5,5,0">
                    <Grid>
                        <Image x:Name="Anpr_image" Source="D:\muvss_name.png" Stretch="Fill" />
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" CornerRadius="3" Background="Transparent" BorderThickness="3" BorderBrush="MidnightBlue">
                            <TextBlock Text="ANPR Image" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="MidnightBlue" FontWeight="Bold" Margin="5,2"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Number Plate Image Section -->
                <Border Grid.Row="1" Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="0,5,5,0">
                    <Grid>
                        <Image x:Name="numberplate_image"  Stretch="Fill"/>
                        <Border VerticalAlignment="Top"   HorizontalAlignment="Left" Visibility="Hidden"  Margin="5" CornerRadius="3" Height="40" Background="Transparent" BorderThickness="3" BorderBrush="MidnightBlue">
                            <TextBlock Text="Number Plate Image"  FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="MidnightBlue" FontWeight="Bold" Margin="5,2"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Number Plate Text Section -->
                <Border Grid.Row="2" Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="0,5,5,0">
                    <Grid>
                        <TextBox x:Name="Numberplate_number_box" Margin="3,3,3,3" BorderThickness="0" Text="" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="25"/>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" CornerRadius="3" Background="Transparent" BorderThickness="3" BorderBrush="MidnightBlue" IsHitTestVisible="False">
                            <TextBlock Text="Number Plate" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="MidnightBlue" FontWeight="Bold" Margin="5,2"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Driver Image Section -->
                <Border Grid.Row="3" Background="Transparent" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="0,5,5,0">
                    <Grid>
                        <Image x:Name="Driver_image" Source="D:\muvss_name.png" Stretch="Fill" />
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5" CornerRadius="3" Background="Transparent" BorderThickness="3" BorderBrush="MidnightBlue">
                            <TextBlock Text="Driver Image" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="MidnightBlue" FontWeight="Bold" Margin="5,2"/>
                        </Border>
                        <Grid  VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="50" Content="PREVIOUS" x:Name="driver_previous_image" BorderBrush="Black" BorderThickness="2" Click="driver_previous_image_Click"/>
                            <Button Grid.Column="1" Height="50" Content="NEXT" x:Name="driver_next_image" BorderBrush="Black" BorderThickness="2" Click="driver_next_image_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

