<Window x:Class="Motwane_UVSS.Presentation.Windows.Report_management_tab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Motwane_UVSS"
        mc:Ignorable="d"
        Title="Motwane Under Vehical Scanning System-AreaScan" Height="1100" Width="1920" WindowState="Maximized" Icon="D:\Work_uvss\logo-motwane-90x90.ico">

    <Grid>
        <Image Source="D:\Work_uvss\MUVSS.png" Stretch="Fill"/>

        <Border CornerRadius="20" 
                Background="White" 
                Padding="20"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                MaxWidth="1800"
                MaxHeight="950">

            <StackPanel Orientation="Vertical">
                <TextBlock Foreground="#007ACC" Text="Report Management" FontSize="60" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="10,10,10,20" HorizontalAlignment="Left" VerticalAlignment="Top" >
                    <TextBlock  Text="Filter:" VerticalAlignment="Center" Margin="5" FontSize="16"/>
                    <ComboBox x:Name="filterTypeComboBox" Width="120" Margin="5" SelectionChanged="FilterTypeComboBox_SelectionChanged"/>

                    <TextBlock  x:Name="fromTextBlock" Text="From:" VerticalAlignment="Center" Margin="5" FontSize="16" Visibility="Collapsed"/>
                    <DatePicker x:Name="fromDatePicker" Width="120" Margin="5"/>

                    <TextBlock x:Name="toTextBlock" Text="To:" VerticalAlignment="Center" Margin="5" FontSize="16" Visibility="Collapsed"/>
                    <DatePicker x:Name="toDatePicker" Width="120" Margin="5"/>

                    <TextBlock Text="Username:" VerticalAlignment="Center" Margin="15,5,5,5" FontSize="16"/>
                    <ComboBox x:Name="usernameComboBox" Width="120" Margin="5" />

                    <TextBlock Text="Numberplate:" VerticalAlignment="Center" Margin="15,5,5,5" FontSize="16"/>
                    <TextBox x:Name="numberplateTextBox" Width="120" Margin="5"/>

                    <Button  x:Name="Btnsearch" Content="Search" Click="Button_Click" Width="70" Margin="20,5,5,5" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
                    <Button  x:Name="Btnclear" Content="Clear" Click="Button_Click_1" Width="70" Margin="20,5,5,5" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600">
                    <DataGrid x:Name="dataGrid" Foreground="#007ACC" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"   >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sr No" Binding="{Binding SrNo}" />
                            <DataGridTextColumn Header="User Name" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="Entry Date" Binding="{Binding EntryDate}" />
                            <DataGridTextColumn Header="Entry Time" Binding="{Binding EntryTime}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" />
                            <DataGridTextColumn Header="Numberplate" Binding="{Binding Numberplate}" />

                            <DataGridTemplateColumn Header="Underside Image">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding UndersideImage}" Width="100" Height="100" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Driver Cam Image">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding DriverCamImage}" Width="100" Height="100" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ANPR Image">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding AnprImage}" Width="100" Height="100" Stretch="Uniform"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Margin="10">
                    <ProgressBar x:Name="loadProgress"
                 Width="300"
                 Height="20"
                 Minimum="0"
                 Maximum="100"
                 Visibility="Collapsed"/>

                    <TextBlock x:Name="progressText"
               Margin="10,0,0,0"
               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                    <Border Margin="10" BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" Background="#007ACC">
                        <Button Content="Export" x:Name="Export_btn_1" Click="Export_btn_1_Click" FontSize="35" Foreground="White" Background="Transparent" Margin="5" BorderThickness="0" FontWeight="SemiBold"/>
                    </Border>
                    <Border Margin="10" BorderBrush="#007ACC" BorderThickness="3" CornerRadius="10" Background="#007ACC">
                        <Button Content="Exit" x:Name="Exit_button_3" Click="Exit_button_3_Click" FontSize="35" Foreground="White" Background="Transparent" Margin="5" BorderThickness="0" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window> 